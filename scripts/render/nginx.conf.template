events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;

    upstream auth_service {
        server 127.0.0.1:3001;
    }

    upstream auction_service {
        server 127.0.0.1:3002;
    }

    upstream bidding_service {
        server 127.0.0.1:3003;
    }

    upstream notification_service {
        server 127.0.0.1:3004;
    }

    upstream community_service {
        server 127.0.0.1:3005;
    }

    upstream payment_service {
        server 127.0.0.1:3006;
    }

    upstream order_service {
        server 127.0.0.1:3007;
    }

    server {
        listen ${PORT};
        server_name _;

        client_max_body_size 15M;

        location /api/auth {
            proxy_pass http://auth_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/auctions {
            proxy_pass http://auction_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/bids {
            proxy_pass http://bidding_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/bidding {
            proxy_pass http://bidding_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/wallet {
            proxy_pass http://payment_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/payment {
            proxy_pass http://payment_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/transactions {
            proxy_pass http://payment_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/notifications {
            proxy_pass http://notification_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 86400;
        }

        location /api/posts {
            proxy_pass http://community_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        location /api/comments {
            proxy_pass http://community_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        location /api/orders {
            proxy_pass http://order_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        location /socket.io {
            proxy_pass http://bidding_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 86400;
        }

        location /health {
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        location / {
            return 200 '{"status": "OK", "service": "auction-api-gateway"}';
            add_header Content-Type application/json;
        }
    }
}
